{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local AI Workspace skill package v2",
  "if": {
    "properties": {
      "skills": {"not": {"contains": {"required": ["tool"]}}}
    }
  },
  "then": {
    "required": ["packageVersion"],
    "properties": {
      "mcp": {"required": ["transport"]}
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "product",
    "skillGroup",
    "mcp",
    "skills"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 2
    },
    "packageVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "product": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,78}[A-Za-z0-9_-])?$"
    },
    "skillGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,78}[A-Za-z0-9_-])?$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url"
      ],
      "properties": {
        "transport": {
          "const": "streamable-http"
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^http://(?:127\\.0\\.0\\.1|localhost|\\[::1\\]):[0-9]+/[^?#]*$"
        },
        "expectedServerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/skill"
      }
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "base64"
      ],
      "properties": {
        "filename": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "base64": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argument",
        "filename",
        "base64"
      ],
      "properties": {
        "argument": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "filename": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "base64": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "file": {
          "$ref": "#/$defs/file"
        },
        "files": {
          "$ref": "#/$defs/files"
        }
      },
      "not": {
        "required": [
          "file",
          "files"
        ]
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "title",
        "description",
        "path"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,78}[A-Za-z0-9_-])?$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "\\.([Mm][Dd])$"
        },
        "accepts": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "^\\.[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$"
          }
        },
        "tools": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/tool"
          }
        },
        "tool": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "file": {
          "$ref": "#/$defs/file"
        },
        "files": {
          "$ref": "#/$defs/files"
        }
      },
      "oneOf": [
        {
          "required": [
            "tools"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "tool"
                ]
              },
              {
                "required": [
                  "file"
                ]
              },
              {
                "required": [
                  "files"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "tool"
          ],
          "not": {
            "anyOf": [
              { "required": ["tools"] },
              { "required": ["file", "files"] }
            ]
          }
        }
      ]
    }
  }
}
